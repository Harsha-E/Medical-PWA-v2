{
  "id": "/",
  "name": "MedCheck",
  "short_name": "MedCheck",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fdf6f0",
  "theme_color": "#ff6b35",
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+medcheck",
      "url": "/?connect=%s"
    },
    {
      "protocol": "medcheck",
      "url": "/?action=%s"
    }
  ],
  "url_handlers": [
    {
      "origin": "medcheck://*"
    }
  ],
  "widgets": [
    {
      "name": "Today's Medications",
      "short_name": "Meds",
      "tag": "medications_today",
      "template": "widgets/meds-widget.html",
      "ms_ac_template": "widgets/meds-widget.html",
      "description": "Your upcoming medications for today."
    },
    {
      "name": "Emergency Medical ID",
      "short_name": "SOS ID",
      "tag": "emergency_id",
      "template": "widgets/sos-widget.html",
      "ms_ac_template": "widgets/sos-widget.html",
      "description": "Quick access to your medical emergency QR code."
    }
  ]
}
